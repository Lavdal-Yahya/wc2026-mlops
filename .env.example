# Copy this file to .env and fill in your values. Never commit .env.

# MLflow tracking server (update to EC2 public IP after L3)
MLFLOW_TRACKING_URI=http://18.224.151.31:5000

# AWS credentials (for DVC S3 remote and boto3)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# S3 bucket (set after L2)
S3_BUCKET=wc2026-mlops-XXXX

# Flask
FLASK_ENV=production
FLASK_SECRET_KEY=change_me_in_production
