# Copy this file to .env and fill in your values. Never commit .env.

# MLflow tracking server (EC2 #1 — Elastic IP, stable across restarts)
MLFLOW_TRACKING_URI=http://18.190.116.80:5000

# AWS credentials (for DVC S3 remote and boto3)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# S3 bucket (raw/ processed/ models/ mlflow/)
S3_BUCKET=wc2026-mlops-lavdal

# Flask
FLASK_ENV=production
FLASK_SECRET_KEY=change_me_in_production
